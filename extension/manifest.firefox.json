{
  "manifest_version": 3,
  "name": "ralgruM Browser Integration",
  "version": "0.1.0",
  "description": "Open Deezer and SoundCloud tracks, albums, playlists, and artists in ralgruM.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ralgrum-integration@ralgrum.app",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      },
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": [
    "https://www.deezer.com/*",
    "https://*.deezer.com/*",
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*"
  ],
  "background": {
    "scripts": ["content/detectors.js", "background.js"]
  },
  "action": {
    "default_title": "ralgruM",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"],
      "matches": [
        "https://www.deezer.com/*",
        "https://*.deezer.com/*",
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.deezer.com/*", "https://*.deezer.com/*"],
      "js": [
        "content/detectors.js",
        "content/deezer-metadata.js",
        "content/spa-navigation.js",
        "content/toast.js",
        "content/content-deezer.js"
      ],
      "css": ["content/toast.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*"],
      "js": [
        "content/detectors.js",
        "content/spa-navigation.js",
        "content/soundcloud-metadata.js",
        "content/toast.js",
        "content/content-soundcloud.js"
      ],
      "css": ["content/toast.css"],
      "run_at": "document_idle"
    }
  ]
}
